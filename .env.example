# Supabase configuration
# --------------------------------------------------------------------
# Copy this file to `.env` (in the same folder) and fill in the real
# values. The `.env` file is gitignored and must NOT be committed.
#
#   1. Copy:   cp .env.example .env      (Mac/Linux)
#              copy .env.example .env    (Windows cmd)
#   2. Paste the real values below (get them from a teammate or from
#      Supabase: Project Settings -> API).
#   3. Restart the dev server (`npm run dev`) after creating/editing .env.
#
# NOTE: Vite only exposes variables that start with VITE_ to the app.
# The anon/publishable key is safe to use in the browser; the SECRET
# service_role key must never go here or in the frontend.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --------------------------------------------------------------------
# RAG ingestion script (scripts/ingest.js) ONLY. Not used by the app.
# These are SECRET and stay local (never committed, never in the frontend).
#   SUPABASE_URL                : same project URL as above, without VITE_ prefix
#   SUPABASE_SERVICE_ROLE_KEY   : Supabase -> Settings -> API -> service_role
#   GEMINI_API_KEY              : from https://aistudio.google.com
# --------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
